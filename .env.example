# LocalMail AI – Umgebungsvariablen
# Kopieren nach .env und Werte eintragen:  cp .env.example .env
# Die .env wird NIE committet (siehe .gitignore).

# --- LLM-Engine ---------------------------------------------------------
# Startwert beim Programmstart; im Dashboard unter «Engine-Einstellungen» umschaltbar.
# "cloud" (alter Name "proxy" geht weiter) = OpenAI-kompatible Cloud-API mit Key
# "ollama" / "lmstudio" = lokaler Server auf diesem Rechner, ohne Key
LLM_BACKEND=cloud

# Cloud-API (OpenAI-kompatibel, z. B. FHNW-Proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna

# Ollama lokal (Standardport 11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# LM Studio lokal (Standardport 1234, lokalen Server in LM Studio einschalten)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# --- LangSmith Tracing --------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=localmail_w1

# --- Google (Gmail + Calendar) ------------------------------------------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ID=primary
# 1 = nur IPv4 zu Google (wenn der Gmail-Abruf mit "timed out" abbricht)
GOOGLE_FORCE_IPV4=0

# --- Speicher -----------------------------------------------------------
SQLITE_PATH=data/localmail.sqlite
TESTSET_PATH=eval/data/testmails.json

# --- Zeitzone (für Kalendereinträge) ------------------------------------
TIMEZONE=Europe/Zurich
