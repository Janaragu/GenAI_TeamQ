# LocalMail AI – Umgebungsvariablen
# Kopieren nach .env und Werte eintragen:  cp .env.example .env
# Die .env wird NIE committet (siehe .gitignore).

# --- LLM-Backend --------------------------------------------------------
# "proxy" = FHNW-Proxy (Entwicklung), "ollama" = lokales Modell
LLM_BACKEND=proxy

# FHNW-Proxy (OpenAI-kompatibel)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# Ollama lokal (OpenAI-kompatibler Endpunkt; API-Key wird ignoriert, darf aber nicht leer sein)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# --- LangSmith Tracing --------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=localmail_w1

# --- Google (Gmail + Calendar) ------------------------------------------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ID=primary

# --- Speicher -----------------------------------------------------------
SQLITE_PATH=data/localmail.sqlite
TESTSET_PATH=eval/data/testmails.json
